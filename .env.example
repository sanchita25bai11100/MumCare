# ==========================================
# MumCare Environment Configuration
# ==========================================

# Application
APP_NAME=MumCare
APP_ENV=development
DEBUG=false

# API
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=your_database_connection_string

# AI Services
AI_PROVIDER=your_ai_provider
AI_API_KEY=your_api_key

# Authentication
SECRET_KEY=replace_with_a_secure_secret

# Notifications
NOTIFICATION_PROVIDER=your_notification_provider

# External Healthcare Services
DOCTOR_SERVICE_URL=your_service_url
